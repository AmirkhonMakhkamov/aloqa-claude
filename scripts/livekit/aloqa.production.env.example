# Production-style aloqa-claude env for LiveKit integration.
# Copy values from the deployment secret manager; do not commit real secrets.

LIVEKIT_URL=wss://livekit.<env>.aloqa.example
LIVEKIT_API_KEY=<active-livekit-api-key>
LIVEKIT_API_SECRET=<active-livekit-api-secret>
LIVEKIT_TOKEN_TTL=6h

# Must match the path component in LiveKit webhook.urls.
LIVEKIT_WEBHOOK_PATH=/livekit/webhook

# Optional rotation window only. Keep empty outside a planned webhook signing
# key rotation; values are accepted for webhook verification only.
LIVEKIT_WEBHOOK_PREVIOUS_API_KEY=
LIVEKIT_WEBHOOK_PREVIOUS_API_SECRET=

# Keep migration file validation on in staging/prod boot.
DB_VALIDATE_MIGRATIONS_ON_START=true
DB_MIGRATIONS_DIR=migrations

# Validation-only. Set only in CI/staging shells that run disposable Postgres
# repository tests; do not set this in the production service environment.
ALOQA_POSTGRES_TEST_DSN=postgres://aloqa:<password>@<host>:5432/aloqa_test?sslmode=require
